// 阶段 2 测试程序 1
// 目标：x31 = 0xCAFEBABE 后无限循环
// 因为暂未实现前递，相邻 RAW 之间手工插入 3 个 NOP
//
// 地址  机器码        汇编
// 0x00  CAFEC0B7     LUI    x1, 0xCAFEC          ; x1 = 0xCAFEC000
// 0x04  00000013     NOP
// 0x08  00000013     NOP
// 0x0C  00000013     NOP
// 0x10  ABE08093     ADDI   x1, x1, 0xABE        ; x1 = 0xCAFEBABE
// 0x14  00000013     NOP
// 0x18  00000013     NOP
// 0x1C  00000013     NOP
// 0x20  00000513     ADDI   x10, x0, 0           ; x10 = 0
// 0x24  00000013     NOP
// 0x28  00000013     NOP
// 0x2C  00000013     NOP
// 0x30  00050463     BEQ    x10, x0, +8          ; taken → 跳到 0x38
// 0x34  BAD00F93     ADDI   x31, x0, 0xBAD       ; 应被 flush，永不写回
// 0x38  00008FB3     ADD    x31, x1, x0          ; x31 = 0xCAFEBABE  → 触发结束
// 0x3C  0000006F     JAL    x0, 0                ; 死循环
//
// $readmemh 把每行视作一个字（32 位）按顺序填入 mem[0], mem[1], ...
CAFEC0B7
00000013
00000013
00000013
ABE08093
00000013
00000013
00000013
00000513
00000013
00000013
00000013
00050463
BAD00F93
00008FB3
0000006F
